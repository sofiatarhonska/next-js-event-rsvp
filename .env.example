# Set up the event page and its RSVP confirmations.
# Copy to .env and fill in your own credentials. Never commit a populated .env.
# See docs/email-setup.md for provider settings. MAIL_MODE=log lets you try the development app without sending.

APP_URL=http://localhost:3000 # Browser origin for the event page; RSVP submissions must come from this address.
HOST=127.0.0.1 # Next.js ignores HOST; use the --hostname option on npm start to change its bind address.
PORT=3000 # Production HTTP port; keep APP_URL consistent with the address people actually use.
DB_PATH=.data/app.sqlite # Attendee records and confirmation-email history; SQLite file relative to the app directory. Preserve it across deployments.
ADMIN_PASSWORD= # Password for admin to inspect the attendee list; generate a random value of at least 16 characters.
OWNER_EMAIL=owner@example.com # Not used for RSVP confirmations; this setting can be left empty.
REVIEWER_EMAIL=reviewer@example.com # No reviewer recipient is needed for RSVP confirmations; leave blank if preferred.
MAIL_MODE=sandbox # sandbox captures RSVP confirmations; production sends them; log writes local previews in development.
MAIL_FROM=sender@example.com # Sender shown on RSVP confirmations. Live sending requires your verified Mailtrap domain.
MAILTRAP_PRODUCTION_TOKEN= # Mailtrap sending token used only when RSVP confirmations go through production mode.
MAILTRAP_SANDBOX_TOKEN= # Sandbox API token from your inbox integration settings; unrelated to the production token.
MAILTRAP_INBOX_ID= # Use the numeric ID from your Sandbox inbox integration to collect test RSVP confirmations.
